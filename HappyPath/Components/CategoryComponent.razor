@using HappyPath.Model

<div class="card border-dark mb-3 category">
    <div class="card-header">@Category</div>
    <div class="card-body">
        <MoodComponent @ref="m_Component"></MoodComponent>
    </div>
</div>

@code {
    MoodComponent m_Component;
    
    [Parameter] public string Category { get; set; }
    public Mood Mood => m_Component.SelectedMood;
    public string Reason => m_Component.Reason;
    public Result Result => new() { Mood = Mood, Reason = Reason, Category = Category };
}