@using HappyPath.Model
<div class="categories">
    @foreach(var category in Categories)
    {
        <CategoryComponent @ref="@Ref" Category="@category"></CategoryComponent>
    }
</div>

@code {
    [Parameter] public IEnumerable<string> Categories { get; set; } = [];
    
    readonly List<CategoryComponent> m_Refs = [];
    CategoryComponent Ref { set => m_Refs.Add(value); }

    public IEnumerable<Result> BuildResults() => m_Refs.Select(c => c.Result);
    public void SetCategories(IEnumerable<string> categories) => Categories = categories;
}